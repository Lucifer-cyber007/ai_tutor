# Copy this file to ".env" and put your real key in it.
# .env is in .gitignore, so it is never committed.

# Get a key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Any Groq chat model your key can use. Check with the Groq console or GET /openai/v1/models.
# gpt-oss-120b is strong at maths; openai/gpt-oss-20b is faster and cheaper.
GROQ_MODEL=openai/gpt-oss-120b
